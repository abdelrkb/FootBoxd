generator client {
  provider      = "prisma-client-js"
  // "native" pour le dev en local (macOS/linux hôte) + le binaire musl/openssl3 requis par les
  // images Docker (node:22-alpine = Alpine 3.24, qui n'a que libssl3, pas de libssl.so.1.1) —
  // trouvé en testant `docker compose up` en réel le 2026-09-16 (erreur "libssl.so.1.1: No
  // such file or directory" sur le moteur Prisma faute de ce binaryTarget explicite).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProviderType {
  google
  apple
  email

  @@map("auth_provider_type")
}

enum MatchStatus {
  scheduled
  live
  finished
  postponed
  cancelled
  suspended
  abandoned

  @@map("match_status")
}

enum NotificationType {
  comment
  like
  follow
  kickoff_reminder

  @@map("notification_type")
}

// Compte & sécurité (2026-10-02) : un seul modèle pour les deux usages (vérification d'email à
// l'inscription, reset de mot de passe) plutôt que deux tables quasi identiques.
enum VerificationCodePurpose {
  email_verification
  password_reset

  @@map("verification_code_purpose")
}

enum ReportTargetType {
  user
  review
  comment

  @@map("report_target_type")
}

enum ReportReason {
  spam
  harassment
  inappropriate_content
  fake_account
  other

  @@map("report_reason")
}

// Refonte design du 2026-09-20 (handoff design_handoff_footboxd) : "faits de match" (buts,
// cartons, remplacements). Alimenté par le worker via l'endpoint TheSportsDB
// `lookup/event_timeline`, vérifié réel et disponible avant d'être ajouté ici.
enum MatchEventType {
  goal
  card
  substitution

  @@map("match_event_type")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String?  @map("password_hash")
  // Handle unique pour retrouver quelqu'un par recherche (décision produit du 2026-09-20),
  // distinct de `displayName` qui reste libre et non-unique.
  username     String   @unique
  // Horodatage du dernier changement de pseudo — limite à une fois tous les 14 jours (décision
  // produit du 2026-10-02), vérifié côté service avant d'autoriser un nouveau changement.
  usernameChangedAt DateTime? @map("username_changed_at")
  displayName  String   @map("display_name")
  // Courte présentation libre sur le profil (2026-10-02), optionnelle.
  bio          String?  @db.VarChar(280)
  avatarUrl    String?  @map("avatar_url")
  // Avatar stocké en base (2026-10-02) : pas de Cloudflare R2 disponible pour l'instant (voir
  // architecture.md section 8). `avatarUrl` pointe alors vers `GET /users/:id/avatar`, qui sert
  // ces octets — ce qui évite de toucher tout le code front qui consomme déjà `avatarUrl` comme
  // une simple URL d'image. Les comptes sans avatar personnalisé gardent `avatarUrl` pointant
  // vers le générateur Dicebear, `avatarData`/`avatarMimeType` restant `null`.
  avatarData     Bytes?  @map("avatar_data")
  avatarMimeType String? @map("avatar_mime_type")
  // Null tant que l'email n'est pas confirmé par code (inscription email/mot de passe
  // uniquement — les comptes Google/Apple sont considérés vérifiés dès la création, leur email
  // étant déjà confirmé par le provider). Décision produit du 2026-10-02 : le compte reste
  // utilisable sans vérification, un bandeau de rappel suffit pour le MVP.
  emailVerifiedAt DateTime? @map("email_verified_at")
  // Incrémenté au changement de mot de passe et à la suppression de compte : le JwtStrategy
  // compare ce compteur à celui encodé dans le JWT (`validate()`), ce qui invalide tous les
  // tokens déjà émis sans avoir à les stocker/révoquer individuellement (JWT reste stateless).
  tokenVersion Int @default(0) @map("token_version")
  // Suppression de compte = anonymisation (décision produit du 2026-10-02, comme Letterboxd) :
  // email/pseudo/nom/avatar/bio sont écrasés par des valeurs génériques, le contenu (reviews,
  // commentaires, follows en tant que cible) reste intact pour ne pas casser les fils des
  // autres utilisateurs. `deletedAt` marque le compte comme supprimé ; non `null` => compte
  // exclu de la recherche et de la connexion.
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  authProviders          AuthProvider[]
  reviews                Review[]
  comments               Comment[]
  reviewLikes            ReviewLike[]
  following              Follow[]       @relation("Follower")
  followers              Follow[]       @relation("Following")
  notificationsReceived  Notification[] @relation("Recipient")
  notificationsTriggered Notification[] @relation("Actor")
  favoriteLeagues        FavoriteLeague[]
  watchlist              WatchlistEntry[]
  verificationCodes      VerificationCode[]
  blocksMade             Block[]          @relation("Blocker")
  blocksReceived         Block[]          @relation("Blocked")
  reportsMade            Report[]

  // "Club de cœur" — décision produit du 2026-09-20 (handoff design), une seule équipe
  // favorite, ses matchs épinglés en haut de l'accueil.
  favoriteTeamId String? @map("favorite_team_id") @db.Uuid
  favoriteTeam   Team?   @relation("FavoriteTeam", fields: [favoriteTeamId], references: [id])

  // Réglages de notification (handoff design, écran "Réglages" de l'onboarding, 2026-09-20).
  // Décision produit : les préférences sont stockées mais seule `hideScoresUntilClick` a un
  // effet réel pour l'instant (purement front) — les autres n'affectent pas encore l'envoi des
  // notifications ni un rappel programmé (nécessiterait une tâche planifiée côté worker,
  // reportée).
  notifyOnLike           Boolean @default(true) @map("notify_on_like")
  notifyOnComment        Boolean @default(true) @map("notify_on_comment")
  notifyOnNewFollower    Boolean @default(true) @map("notify_on_new_follower")
  notifyKickoffReminder  Boolean @default(false) @map("notify_kickoff_reminder")
  hideScoresUntilClick   Boolean @default(false) @map("hide_scores_until_click")
  hasCompletedOnboarding Boolean @default(false) @map("has_completed_onboarding")

  // Watchlist (2026-09-30) : visibilité par défaut privée, l'utilisateur peut la rendre
  // publique pour que son profil affiche un bouton "Voir la watchlist" à ses visiteurs.
  isWatchlistPublic Boolean @default(false) @map("is_watchlist_public")
  // Distinct de `notifyKickoffReminder` (qui reste dédié aux ligues favorites, toujours sans
  // effet) : celui-ci ne rappelle que les matchs explicitement ajoutés à la watchlist, envoyé
  // par apps/worker/src/sync/kickoff-reminders.ts.
  notifyWatchlistKickoff Boolean @default(false) @map("notify_watchlist_kickoff")

  @@map("users")
}

model AuthProvider {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  provider       AuthProviderType
  providerUserId String           @map("provider_user_id")
  createdAt      DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_providers")
}

model League {
  id             String  @id @default(uuid()) @db.Uuid
  externalId     String  @unique @map("external_id")
  name           String
  country        String?
  logoUrl        String? @map("logo_url")
  // Saison en cours, ex "2025-2026" (section 8 : "pas de calcul de dates fait maison" — on
  // reprend telle quelle la valeur `strSeason` du dernier event synchronisé pour cette ligue,
  // voir apps/worker/src/sync/upsert.ts). Ajouté le 2026-09-16 : nécessaire pour la stat
  // "matchs vus cette saison" du profil (section 7), absent du modèle initial.
  currentSeason  String? @map("current_season")

  matches         Match[]
  favoritedBy     FavoriteLeague[]

  @@map("leagues")
}

// Refonte accueil (2026-09-17) : l'accueil liste les ligues favorites de l'utilisateur (celles
// ayant au moins un match à la date sélectionnée) plutôt que toutes les ligues avec filtre.
// Une page "Toutes les ligues" séparée permet d'ajouter/retirer des favoris.
model FavoriteLeague {
  userId    String   @map("user_id") @db.Uuid
  leagueId  String   @map("league_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@id([userId, leagueId])
  @@map("favorite_leagues")
}

model Team {
  id         String  @id @default(uuid()) @db.Uuid
  externalId String  @unique @map("external_id")
  name       String
  logoUrl    String? @map("logo_url")

  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")
  matchEvents MatchEvent[]
  favoritedByUsers User[] @relation("FavoriteTeam")

  @@map("teams")
}

model Match {
  id         String      @id @default(uuid()) @db.Uuid
  externalId String      @unique @map("external_id")
  leagueId   String      @map("league_id") @db.Uuid
  homeTeamId String      @map("home_team_id") @db.Uuid
  awayTeamId String      @map("away_team_id") @db.Uuid
  homeScore  Int?        @map("home_score")
  awayScore  Int?        @map("away_score")
  status     MatchStatus
  kickoffAt  DateTime    @map("kickoff_at")
  // Minute affichée pendant le direct (strProgress TheSportsDB, ex "45", "45+2") — texte brut,
  // pas un entier : la mi-temps peut arriver avec du temps additionnel ("45+1").
  liveMinute   String?     @map("live_minute")
  venue        String?
  season       String
  lineups      Json?
  highlightUrl String?     @map("highlight_url")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  league   League   @relation(fields: [leagueId], references: [id])
  homeTeam Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  reviews  Review[]
  events   MatchEvent[]
  watchlistedBy WatchlistEntry[]

  @@map("matches")
}

// Watchlist (2026-09-30) : matchs qu'un utilisateur prévoit de regarder, avec rappel de
// notification optionnel 30 min avant le coup d'envoi (réutilise `User.notifyKickoffReminder`,
// jusque-là stocké mais sans effet — voir schema.prisma section User). `reminderSentAt` évite
// qu'un même match génère plusieurs rappels si le worker tourne plusieurs fois dans la fenêtre.
model WatchlistEntry {
  userId         String    @map("user_id") @db.Uuid
  matchId        String    @map("match_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  reminderSentAt DateTime? @map("reminder_sent_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@id([userId, matchId])
  @@map("watchlist_entries")
}

model MatchEvent {
  id         String         @id @default(uuid()) @db.Uuid
  matchId    String         @map("match_id") @db.Uuid
  externalId String         @unique @map("external_id") // idTimeline TheSportsDB
  type       MatchEventType
  // Valeur brute API ("Normal Goal", "Yellow Card", "Red Card", ...) — pas d'enum fermé ici,
  // TheSportsDB peut renvoyer des variantes non recensées, le front décide de l'affichage.
  detail     String?
  minute     Int
  isHome     Boolean        @map("is_home")
  teamId     String         @map("team_id") @db.Uuid
  playerName String?        @map("player_name")
  assistName String?        @map("assist_name")
  createdAt  DateTime       @default(now()) @map("created_at")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id])

  @@map("match_events")
}

model Review {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  matchId   String    @map("match_id") @db.Uuid
  rating    Decimal   @db.Decimal(2, 1)
  comment   String?
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  match    Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    ReviewLike[]
  tags     ReviewTag[]

  // Pas de @@unique/@@index ici : la vraie contrainte est un index UNIQUE PARTIEL
  // (WHERE deleted_at IS NULL) + un CHECK sur `rating`, tous deux ajoutés à la main
  // dans la migration SQL (non exprimables dans schema.prisma) — voir section 6 de
  // architecture.md et packages/database/prisma/migrations/20260916131938_init/migration.sql.
  // Ne pas ajouter de @@index/@@unique équivalent ici : Prisma le considérerait comme
  // "manquant" en base lors d'un futur `migrate dev` et générerait une migration corrective
  // en doublon de celui posé à la main.
  @@map("reviews")
}

// Tag libre posé sur une review (ambiance, avec qui, où… — champ non structuré, décision
// produit du 27/09) : nom unique partagé entre tous les users (autocomplete + réutilisation
// de la couleur déjà choisie par un tag existant), couleur solide ou dégradé (colorEnd) choisie
// à la création par le premier utilisateur du tag.
model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  color     String
  colorEnd  String?  @map("color_end")
  createdAt DateTime @default(now()) @map("created_at")

  reviews ReviewTag[]

  @@map("tags")
}

model ReviewTag {
  reviewId String @map("review_id") @db.Uuid
  tagId    String @map("tag_id") @db.Uuid

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([reviewId, tagId])
  @@map("review_tags")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  reviewId  String   @map("review_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model ReviewLike {
  userId    String   @map("user_id") @db.Uuid
  reviewId  String   @map("review_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
  @@map("review_likes")
}

model Follow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@map("follows")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  actorId     String           @map("actor_id") @db.Uuid
  type        NotificationType
  // Polymorphe : pointe vers une review ou un commentaire selon `type`, donc pas de FK.
  referenceId String?          @map("reference_id") @db.Uuid
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @map("created_at")

  recipient User @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User @relation("Actor", fields: [actorId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model VerificationCode {
  id         String                  @id @default(uuid()) @db.Uuid
  userId     String                  @map("user_id") @db.Uuid
  purpose    VerificationCodePurpose
  // Le code (6 chiffres) n'est jamais stocké en clair, seulement son hash bcrypt — même
  // logique que les mots de passe, au cas où la base fuiterait.
  codeHash   String                  @map("code_hash")
  expiresAt  DateTime                @map("expires_at")
  consumedAt DateTime?               @map("consumed_at")
  // Anti brute-force sur la saisie (ex: 5 tentatives max) — distinct du rate-limiting sur la
  // route elle-même (section 8), qui limite la fréquence des requêtes, pas les essais sur un
  // code précis.
  attempts   Int                     @default(0)
  createdAt  DateTime                @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_codes")
}

model Block {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@map("blocks")
}

model Report {
  id         String           @id @default(uuid()) @db.Uuid
  reporterId String           @map("reporter_id") @db.Uuid
  targetType ReportTargetType @map("target_type")
  // Polymorphe (id d'un user, d'une review ou d'un commentaire selon targetType) — même
  // pattern que `notifications.reference_id`, pas de FK possible.
  targetId   String           @map("target_id") @db.Uuid
  reason     ReportReason
  details    String?
  createdAt  DateTime         @default(now()) @map("created_at")

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("reports")
}
