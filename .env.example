# Database
DATABASE_URL=postgresql://user:password@postgres:5432/football_app

# Redis
REDIS_URL=redis://redis:6379

# API sportive (TheSportsDB)
SPORTS_API_KEY=
SPORTS_API_V1_BASE_URL=https://www.thesportsdb.com/api/v1/json
SPORTS_API_V2_BASE_URL=https://www.thesportsdb.com/api/v2/json

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:3000/auth/apple/callback

# Email (Brevo) — codes de vérification à l'inscription + reset de mot de passe (2026-10-02).
# Sans BREVO_API_KEY, les emails ne partent pas : le code atterrit dans les logs de l'API, ce
# qui suffit pour développer en local. Mise en place du compte Brevo : voir README.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@footboxd.app
EMAIL_FROM_NAME=FootBoxd

# Stockage (Cloudflare R2) — pas encore câblé côté code (l'avatar est stocké en base de données
# le temps qu'un compte R2 soit disponible, voir users.service.ts), mais utilisé par
# scripts/backup-postgres.sh pour les backups Postgres en prod (section 9)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# App
NODE_ENV=development
PORT=3000
WEB_URL=http://localhost:3010
# Lu par apps/web au build (Next.js inline les NEXT_PUBLIC_* côté client à la compilation,
# pas au runtime du conteneur — voir apps/web/.env.local pour le dev local via `next dev`)
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Prod uniquement (docker-compose.prod.yml, voir architecture.md section 9) ---
# Doivent correspondre exactement à ce qui est dans DATABASE_URL ci-dessus.
POSTGRES_DB=football_app
POSTGRES_USER=
POSTGRES_PASSWORD=
# Compte/organisation GitHub propriétaire des images ghcr.io (ex: "abdel")
GHCR_OWNER=
# Écrasé à chaque déploiement CI par le SHA du commit (voir .github/workflows/deploy.yml) ;
# valeur par défaut si absent :
IMAGE_TAG=latest